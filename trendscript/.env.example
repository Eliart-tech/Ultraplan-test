# TrendScript — variables d'environnement
#
# En local : copiez ce fichier en .env.local (jamais commité), remplissez les
# valeurs utiles, puis redémarrez `npm run dev`.
# En production (Vercel…) : saisissez les mêmes variables dans le tableau de
# bord de l'hébergeur, puis redéployez.
#
# Toutes les variables sont facultatives : sans clé, une source est affichée
# « non configurée » et ignorée ; elle n'est jamais remplacée par des données
# fictives. La page Réglages de l'application indique ce qui est actif.

# ---------------------------------------------------------------------------
# Accès à l'application
# ---------------------------------------------------------------------------

# Mot de passe unique demandé à l'ouverture de l'application. Vide = application
# ouverte à tous (acceptable en local, à éviter absolument une fois en ligne :
# chaque analyse et chaque script consomment vos quotas et vos crédits payants).
APP_PASSWORD=

# Clé de signature des sessions (recommandé en production). Valeur aléatoire
# d'au moins 32 caractères, par exemple : openssl rand -base64 32
# Vide = clé dérivée de APP_PASSWORD (changer le mot de passe déconnecte alors
# tout le monde).
AUTH_SECRET=

# ---------------------------------------------------------------------------
# Claude (Anthropic) — regroupement des tendances en sujets et écriture des scripts
# ---------------------------------------------------------------------------

# Clé API depuis https://console.anthropic.com/settings/keys
# Sans elle : analyse en « mode sans IA » (regroupement automatique, sans angles)
# et génération de script indisponible.
ANTHROPIC_API_KEY=

# Modèle Claude (facultatif). Par défaut : claude-opus-5-5
ANTHROPIC_MODEL=

# ---------------------------------------------------------------------------
# Google
# ---------------------------------------------------------------------------

# SerpApi (Google Trends via un fournisseur sous licence + recherches associées
# en hausse). Offre gratuite : 250 recherches par mois.
# https://serpapi.com/manage-api-key
SERPAPI_API_KEY=

# ---------------------------------------------------------------------------
# YouTube
# ---------------------------------------------------------------------------

# YouTube Data API v3 (Google Cloud Console → API et services → Identifiants).
# Gratuit dans la limite du quota (100 recherches par jour).
YOUTUBE_API_KEY=

# Chaînes suivies par la source gratuite « YouTube – chaînes d'actualité (RSS) » :
# identifiants UC… séparés par des virgules (10 maximum). Vide = sélection de
# chaînes d'info françaises.
YOUTUBE_RSS_CHANNELS=

# ---------------------------------------------------------------------------
# Instagram & TikTok via Apify (payant à l'usage, 5 $ de crédit offert par mois)
# ---------------------------------------------------------------------------

# Jeton personnel : https://console.apify.com → Settings → API & Integrations.
# Active les sources « Instagram Reels (Apify) » et « TikTok (Apify) ».
APIFY_TOKEN=

# Coût maximal d'une exécution d'acteur Apify, en dollars (défaut : 0.5).
APIFY_MAX_CHARGE_USD=

# Acteurs TikTok de remplacement (facultatif), par exemple
# clockworks~free-tiktok-scraper pour une recherche de vidéos moins chère.
APIFY_TIKTOK_ACTOR=
APIFY_TIKTOK_TRENDS_ACTOR=

# ---------------------------------------------------------------------------
# LinkedIn
# ---------------------------------------------------------------------------

# Firecrawl (https://www.firecrawl.dev → API Keys, clé « fc-… ») : active la
# source « LinkedIn — publications récentes (recherche web) ». Les publications
# avec réactions et commentaires passent par APIFY_TOKEN (source « LinkedIn —
# engagement (Apify) »).
FIRECRAWL_API_KEY=

# ---------------------------------------------------------------------------
# Instagram — API officielle Meta (gratuite, configuration plus longue)
# ---------------------------------------------------------------------------

# Jeton d'accès longue durée (≈ 60 jours) d'une app Meta reliée à votre compte
# Instagram professionnel. Étapes détaillées dans Réglages.
INSTAGRAM_ACCESS_TOKEN=

# Identifiant de votre compte Instagram professionnel (commence par 1784…).
INSTAGRAM_USER_ID=

# Comptes Créateur ou Entreprise à surveiller, séparés par des virgules
# (10 maximum), par exemple : hugodecrypte,konbini
INSTAGRAM_WATCH_ACCOUNTS=

# Version de l'API Graph (facultatif). Par défaut : v25.0
INSTAGRAM_GRAPH_VERSION=

# ---------------------------------------------------------------------------
# Wikipédia
# ---------------------------------------------------------------------------

# Contact (URL ou e-mail) envoyé dans l'en-tête User-Agent, comme le demande la
# politique d'accès de Wikimedia (facultatif).
WIKIPEDIA_CONTACT=
