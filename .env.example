# Canonical URL of the deployment — used for metadata, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL="https://www.maivenagency.com"

# Contact form delivery (optional).
# Without RESEND_API_KEY the form still works: submissions are logged instead of
# being e-mailed, so previews and local development never break.
RESEND_API_KEY=""
CONTACT_TO_EMAIL="contact@maivenagency.com"
CONTACT_FROM_EMAIL="Site Maiven <bonjour@maivenagency.com>"
